# ── App ──────────────────────────────────────────
APP_ENV=development
SECRET_KEY=super-secret-key-change-in-production-at-least-32-chars
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────
POSTGRES_DB=kamuilan
POSTGRES_USER=kamuilan
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://kamuilan:changeme@postgres:5432/kamuilan
SYNC_DATABASE_URL=postgresql+psycopg2://kamuilan:changeme@postgres:5432/kamuilan

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Celery ────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Admin ─────────────────────────────────────────
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=admin123

# ── Scraper ───────────────────────────────────────
SCRAPER_REQUEST_DELAY_MIN=1.0
SCRAPER_REQUEST_DELAY_MAX=3.0
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT=30

# ── Frontend ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api
